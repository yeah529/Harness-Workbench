{
  "name": "dsh-cyberpunk-workbench",
  "version": "0.1.0",
  "description": "Cyberpunk 2077-themed Workbench UI plugin for DeepSeek Harness: project-card workspaces, RC.8-native sessions, todos, knowledge base, scheduled tasks and daily summaries.",
  "author": "yeah529",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yeah529/Harness-Workbench.git"
  },
  "homepage": "https://github.com/yeah529/Harness-Workbench#readme",
  "bugs": {
    "url": "https://github.com/yeah529/Harness-Workbench/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "workbench",
    "knowledge-base",
    "rag",
    "ollama",
    "cyberpunk"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "main": "lib/index.js",
  "files": [
    "bin",
    "lib",
    "src/host",
    "src/launcher",
    "scripts/build.mjs",
    "scripts/install.sh",
    "scripts/reset-demo.mjs",
    "dsh-codex.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "package.json"
  ],
  "bin": {
    "dsh-workbench": "./bin/dsh-workbench.js"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "reset:demo": "node scripts/reset-demo.mjs",
    "test": "node --test test/*.test.js && node scripts/verify.cjs",
    "check": "npm run build && npm test && node --check lib/index.js && node --check lib/client.js"
  },
  "license": "MIT",
  "overrides": {
    "@huggingface/transformers": {
      "sharp": "0.35.3"
    },
    "officeparser": {
      "pdfjs-dist": "6.2.108"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-agent": "0.1.0-rc.8",
    "@deepseek-ai/dsh-agent-presets": "0.1.0-rc.8",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.8",
    "@deepseek-ai/dsh-session": "0.1.0-rc.8",
    "@lancedb/lancedb": "0.37.1",
    "apache-arrow": "18.1.0",
    "html-to-text": "10.0.1",
    "officeparser": "7.6.2"
  },
  "devDependencies": {
    "@phosphor-icons/react": "2.1.10",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "react-dom": "18.3.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-connection": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-locale": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-input-trigger": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-settings-general": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-theme": "0.1.0-rc.8",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  }
}
